# Copiá este archivo como .env (npm run dev lo hace solo si no existe).
# Para correr los comandos del piloto contra producción, copialo como .env.produccion, completalo
# con los valores de producción y usá CHARLA_ENV_FILE=.env.produccion (ver docs/checklist-piloto.md).
# Cada fase agrega acá las variables nuevas. Nunca subas el .env al repositorio.

# Entorno de la aplicación: local o production.
APP_ENV=local

# Puerto donde escucha el servidor.
PORT=3000

# Nivel de los logs: fatal, error, warn, info, debug o trace.
LOG_LEVEL=info

# Conexión a Postgres. Este valor apunta a la base de docker-compose.yml.
DATABASE_URL=postgres://charla:charla_local@localhost:5433/charla

# Claves para cifrar y buscar teléfonos: 32 bytes en base64.
# En local se pueden dejar vacías, porque se usan claves de desarrollo.
# En producción son obligatorias y cada una tiene que ser distinta. Para generarlas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde PHONE_ENCRYPTION_KEY, no se pueden recuperar los teléfonos ni los links guardados.
# PHONE_ENCRYPTION_KEY=
# PHONE_HASH_KEY=

# Dirección pública de la app, sin barra al final: con ella se arman los links del piloto web.
# Fuera de local tiene que empezar con https://.
PUBLIC_BASE_URL=http://localhost:3000

# Proveedor de IA del tutor: mock (simulado, no gasta plata) o anthropic.
LLM_PROVIDER=mock

# Solo con LLM_PROVIDER=anthropic. Se crea en la consola de Anthropic y nunca se sube al repo.
# ANTHROPIC_API_KEY=

# Modelo del tutor y tope de gasto en IA por persona y por día, en dólares.
# 0,01 son unos ARS 15 por día: entra en la meta de ARS 500 por mes.
TUTOR_MODEL=claude-haiku-5-5
TUTOR_DAILY_BUDGET_USD=0.01

# Voz a texto: mock (usa lo que reconoce el navegador) u openai.
STT_PROVIDER=mock
# Solo con STT_PROVIDER=openai. Nunca se sube al repo.
# OPENAI_API_KEY=
# gpt-4o-mini-transcribe se da de baja el 26/2/2027.
STT_MODEL=gpt-transcribe

# Texto a voz: mock (lee el navegador) o azure.
TTS_PROVIDER=mock
# Solo con TTS_PROVIDER=azure. La región es la del recurso de Azure, por ejemplo eastus.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
TTS_VOICE=es-AR-ElenaNeural
# Formato de los audios de Charlá: ogg (nota de voz de WhatsApp) o mp3 (la web: suena en todos
# los iPhone; OGG recién desde iOS 18.4).
TTS_AUDIO_FORMAT=ogg

# Carpeta donde se guardan los audios que genera Charlá, para no pagarlos dos veces.
AUDIO_CACHE_DIR=var/audio

# WhatsApp: disabled (sin webhook), fake (webhook real, envíos falsos, solo local) o cloud.
# Con fake, las respuestas quedan en var/whatsapp-salida.jsonl. Probalo con:
#   npm run whatsapp:simulate -- "hola"
WHATSAPP_PROVIDER=disabled
# Con fake alcanzan estos valores de ejemplo. Con cloud, son secretos: van solo en el servidor.
# WHATSAPP_APP_SECRET=secreto-solo-local
# WHATSAPP_VERIFY_TOKEN=token-solo-local
# Solo con cloud. Cómo conseguirlos: docs/checklist-piloto.md.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v27.0
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
