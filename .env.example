# Copiá este archivo como .env (npm run dev lo hace solo si no existe).
# Cada fase agrega acá las variables nuevas. Nunca subas el .env al repositorio.

# Entorno de la aplicación: local, staging o production.
APP_ENV=local

# Puerto donde escucha el servidor.
PORT=3000

# Nivel de los logs: fatal, error, warn, info, debug o trace.
LOG_LEVEL=info

# Conexión a Postgres. Este valor apunta a la base de docker-compose.yml.
DATABASE_URL=postgres://charla:charla_local@localhost:5433/charla
